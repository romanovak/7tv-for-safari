{
  "manifest_version": 3,
  "name": "7TV para Safari",
  "version": "0.1.0",
  "description": "Muestra emotes de 7TV (globales y del canal) en el chat de Twitch.",
  "icons": { "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png", "512": "icons/icon-512.png" },
  "background": { "scripts": ["loader.js", "background.js"] },
  "content_scripts": [
    {
      "matches": ["*://*.twitch.tv/*"],
      "js": ["loader.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["*://*.twitch.tv/*", "https://7tv.io/*", "https://gql.twitch.tv/*", "https://cdn.7tv.app/*", "https://api.betterttv.net/*", "https://cdn.betterttv.net/*"]
}
